# Google OAuth 2.0 Web client ID (required).
# Create it in Google Cloud Console > APIs & Services > Credentials >
# OAuth client ID > Web application. Add your console origin under
# "Authorized JavaScript origins" (for example http://localhost:3000).
GOOGLE_CLIENT_ID=

# Base64-encoded 32-byte key used to encrypt stored instance passwords
# with AES-256-GCM. Generate one with: npm run keygen
# Losing this key makes existing stored passwords unrecoverable.
PASSWORD_ENC_KEY=

# HTTP server
HOST=0.0.0.0
PORT=3000

# SQLite database and WAL files live here. Keep this directory private.
DATA_DIR=./data

# Optional access allowlist. When both are empty, any verified Google
# account can sign in and create an account on this server.
# ALLOWED_EMAILS=you@example.com,teammate@example.com
# ALLOWED_EMAIL_DOMAINS=example.com

# Optional allowlist of target hosts for Hermes instances. When set,
# every instance URL must use one of these hosts (comma-separated).
# INSTANCE_HOST_ALLOWLIST=hermes.example.com,192.168.1.100

# Set to true to reject private/link-local target addresses. Leave false
# when your Hermes instances run on a LAN or localhost.
BLOCK_PRIVATE_TARGETS=false

# Set to true when running behind a reverse proxy that terminates TLS so
# secure cookies and client IPs are detected correctly.
TRUST_PROXY=false

# Cookie Secure attribute: auto | always | never.
# "auto" marks cookies Secure when the request arrived over HTTPS.
COOKIE_SECURE=auto
